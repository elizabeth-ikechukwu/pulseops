# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=pulseops
PGUSER=pulseops
PGPASSWORD=change-me-locally
PG_POOL_MAX=10
PGSSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BCRYPT_ROUNDS=12
